# 仅为配置模板；使用 scripts/init-env.py 生成本地随机凭据，不直接复制占位密码运行。
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5440
POSTGRES_USER=backend_dev
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_VALUE
POSTGRES_DB=backend_development
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_VALUE
ADMIN_API_KEY=REPLACE_WITH_RANDOM_LOCAL_VALUE
API_PORT=8010
# 团队副本使用独立 Compose 项目；原开发目录的数据库卷不会被复用。
COMPOSE_PROJECT_NAME=ict-backend
DEMO_HEARTBEAT_SECONDS=30
# 只有外部 AI 服务实际部署后才设置以下值；API 会调用 AI_SERVICE_URL/v1/ask。
# AI_SERVICE_URL=https://YOUR_AI_SERVICE_HOST
# AI_SERVICE_TOKEN=REPLACE_WITH_AI_SERVICE_TOKEN_IF_REQUIRED
# 直接调用 DeepSeek 官方 API 时，只在本地 .env 填写实际密钥。
# DEEPSEEK_API_KEY=REPLACE_WITH_YOUR_DEEPSEEK_API_KEY
# DEEPSEEK_MODEL=deepseek-flash
# 平台默认模型只在后端配置；Agent、浏览器均不读取模型密钥。
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
# LLM_API_KEY_FILE=/ABSOLUTE_PRIVATE_PATH/llm-api-key
# 如用环境变量注入，可设置 LLM_API_KEY，兼容 DEEPSEEK_API_KEY / DASHSCOPE_API_KEY。
# LLM_BASE_URL=https://api.deepseek.com
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_ATTEMPTS=2
# 百炼：LLM_PROVIDER=qwen，LLM_MODEL=qwen-plus；Key 与服务地址必须属于同一地域。
# LLM_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 阿里云百炼文本向量服务；Key 与工作空间地址必须属于同一地域。
# 配置后 beat 会逐步处理现有 pending 文档，可能产生云端调用费用。
# EMBEDDING_API_KEY=REPLACE_WITH_YOUR_MODEL_STUDIO_API_KEY
# EMBEDDING_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
# 独立 Agent 服务；尚未部署时保持未配置，网关返回 503。
# AGENT_SERVICE_URL=http://host.docker.internal:9000
# AGENT_SERVICE_TOKEN=REPLACE_WITH_SERVICE_TOKEN
# AGENT_TOOL_TOKEN=REPLACE_WITH_RANDOM_READ_TOOL_TOKEN
# AGENT_WRITE_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_WRITE_TOKEN
# INDEX_PROVIDER=internal
# QA_PROVIDER=auto
# NVD_API_KEY=REPLACE_WITH_OPTIONAL_NVD_KEY
# USER_QUERIES_PER_MINUTE=10
# USER_QUERIES_PER_DAY=100

# Phone accounts: identifiers only; SMS ownership verification is not configured.
SIGNUP_ENABLED=true
ACCOUNT_SESSION_HOURS=8
