          "enum": [
            "known",
            "unknown",
            "unprocessed",
            "not_found",
            "failed",
            "pending_review"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "method": {
          "enum": [
            "source_structured",
            "source_link",
            "rule",
            "model"
