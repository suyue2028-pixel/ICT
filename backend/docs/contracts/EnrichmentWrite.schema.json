          },
          "maxItems": 20,
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "state",
        "method"
      ],
      "title": "EnrichmentField",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "document_id": {
      "format": "uuid",
      "title": "Document Id",
      "type": "string"
    },
    "content_hash": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Content Hash",
      "type": "string"
    },
    "provider": {
      "pattern": "^[A-Za-z0-9_.-]{1,40}$",
      "title": "Provider",
      "type": "string"
