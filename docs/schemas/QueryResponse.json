{
  "$defs": {
    "AnswerCoverage": {
      "additionalProperties": false,
      "properties": {
        "answered_topics": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Answered Topics",
          "type": "array"
        },
        "missing_topics": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 12,
          "title": "Missing Topics",
          "type": "array"
        }
      },
      "title": "AnswerCoverage",
      "type": "object"
    },
    "Assertion": {
      "additionalProperties": false,
      "properties": {
        "assertion_id": {
          "default": "",
          "title": "Assertion Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value": {
          "title": "Value"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "origin": {
          "enum": [
            "source_structured",
            "rule_extracted",
            "llm_candidate"
          ],
          "title": "Origin",
          "type": "string"
        },
        "verification": {
          "enum": [
            "source_recorded",
            "needs_review"
          ],
          "title": "Verification",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "version",
        "entity_id",
        "field",
        "value",
        "evidence_ids",
        "origin",
        "verification",
        "recorded_at"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "default": "fact",
          "enum": [
            "fact",
            "inference"
          ],
          "title": "Kind",
          "type": "string"
        },
        "topic_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Topic Ids",
          "type": "array"
        }
      },
      "required": [
        "text",
        "evidence_ids"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidenceDetail": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "excerpt": {
          "title": "Excerpt",
          "type": "string"
        },
        "locator": {
          "additionalProperties": true,
          "title": "Locator",
          "type": "object"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "document_id",
        "version",
        "title",
        "url",
        "excerpt",
        "locator",
        "collected_at"
      ],
      "title": "EvidenceDetail",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "elapsed_ms": {
          "default": 0,
          "title": "Elapsed Ms",
          "type": "number"
        },
        "llm_calls": {
          "default": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "embedding_mode": {
          "default": "unknown",
          "title": "Embedding Mode",
          "type": "string"
        },
        "index_generation": {
          "default": 0,
          "title": "Index Generation",
          "type": "integer"
        }
      },
      "title": "Metrics",
      "type": "object"
    },
    "RequirementCoverage": {
      "additionalProperties": false,
      "properties": {
        "requirement_id": {
          "maxLength": 40,
          "title": "Requirement Id",
          "type": "string"
        },
        "label": {
          "maxLength": 120,
          "title": "Label",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "partial",
            "conflicting",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 50,
          "title": "Evidence Ids",
          "type": "array"
        },
        "reason": {
          "maxLength": 200,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "label",
        "status",
        "reason"
      ],
      "title": "RequirementCoverage",
      "type": "object"
    },
    "RetrievalSummary": {
      "additionalProperties": false,
      "properties": {
        "rounds": {
          "default": 0,
          "maximum": 3,
          "minimum": 0,
          "title": "Rounds",
          "type": "integer"
        },
        "stop_reason": {
          "default": "not_started",
          "maxLength": 80,
          "title": "Stop Reason",
          "type": "string"
        },
        "initial_tools": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Initial Tools",
          "type": "array"
        },
        "supplemental_tools": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Supplemental Tools",
          "type": "array"
        }
      },
      "title": "RetrievalSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "ok",
        "partial",
        "insufficient_evidence",
        "error"
      ],
      "title": "Status",
      "type": "string"
    },
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "response_kind": {
      "default": "knowledge",
      "enum": [
        "knowledge",
        "conversation"
      ],
      "title": "Response Kind",
      "type": "string"
    },
    "retrieval_mode_override": {
      "anyOf": [
        {
          "const": "llm_unverified",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieval Mode Override"
    },
    "coverage": {
      "$ref": "#/$defs/AnswerCoverage"
    },
    "question_type": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question Type"
    },
    "requirement_coverage": {
      "items": {
        "$ref": "#/$defs/RequirementCoverage"
      },
      "maxItems": 40,
      "title": "Requirement Coverage",
      "type": "array"
    },
    "retrieval_summary": {
      "$ref": "#/$defs/RetrievalSummary"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "title": "Limitations",
      "type": "array"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/Claim"
      },
      "title": "Claims",
      "type": "array"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/EvidenceDetail"
      },
      "title": "Sources",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Assertion"
      },
      "title": "Facts",
      "type": "array"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "trace_id": {
      "title": "Trace Id",
      "type": "string"
    },
    "metrics": {
      "$ref": "#/$defs/Metrics"
    },
    "mode": {
      "enum": [
        "live",
        "mock",
        "extractive"
      ],
      "title": "Mode",
      "type": "string"
    }
  },
  "required": [
    "status",
    "answer",
    "trace_id",
    "mode"
  ],
  "title": "QueryResponse",
  "type": "object"
}