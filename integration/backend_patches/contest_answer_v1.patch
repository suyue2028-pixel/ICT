diff --git a/backend/tests/test_contest_answer_prompts.py b/backend/tests/test_contest_answer_prompts.py
new file mode 100644
--- /dev/null
+++ b/backend/tests/test_contest_answer_prompts.py
@@ -0,0 +1,88 @@
+"""Prompt contract checks only: no credentials, vendor calls or semantic scoring."""
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from backend.schemas.llm import CompletionRequest
+from backend.services.llm_prompts import SYSTEM
+from backend.services.platform_llm import PlatformLLM
+
+
+@pytest.mark.parametrize("purpose", ["synthesize", "verify"])
+@pytest.mark.parametrize("detail_level,max_claims,max_claim_chars", [
+    ("concise", 4, 160), ("detailed", 8, 240),
+])
+def test_adaptive_output_profile_reaches_professional_model_unchanged(
+        purpose, detail_level, max_claims, max_claim_chars):
+    profile = {"detail_level": detail_level, "max_claims": max_claims,
+        "max_claim_chars": max_claim_chars, "sections": ["conclusion", "conditions"],
+        "show_source_links": True, "explain_relation": True}
+    adapter = PlatformLLM(SimpleNamespace(llm_provider="deepseek",
+        platform_llm_model="deepseek-flash", platform_llm_base_url="https://api.deepseek.com"))
+    request = CompletionRequest(purpose=purpose, payload={
+        "question": "两份资料中的条件如何关联？",
+        "answer_requirements": {"coverage_topics": [], "output_profile": profile},
+        "evidence": []})
+    body = adapter._body(request)
+    payload = json.loads(body["messages"][-1]["content"])
+    assert body["messages"][0]["content"] == SYSTEM
+    assert payload["answer_requirements"]["output_profile"] == profile
+    for field in profile:
+        assert field in SYSTEM
+    assert "最多4条" in SYSTEM and "160个字符" in SYSTEM
+    assert "最多8条" in SYSTEM and "240个字符" in SYSTEM
+
+
+def test_prompt_keeps_claim_schema_and_source_guards_with_conditional_sections():
+    assert "synthesize 根对象只允许 claims 字段" in SYSTEM
+    assert "每项只允许 text、evidence_ids、kind、topic_ids 四个字段" in SYSTEM
+    assert "claims 必须是数组，最多8项" in SYSTEM
+    assert "不逐项套用固定长模板" in SYSTEM
+    assert "普通定义题无需额外风险清单" in SYSTEM
+    assert "不在 claim.text 中生成网址" in SYSTEM
+    assert "不重复长篇资料缺口" in SYSTEM
+    assert "结构化 limitations 统一展示" in SYSTEM
+    assert "不输出内部思维链、评分规则、路由决策" in SYSTEM
+
+
+def test_relationship_explanation_requires_endpoints_conditions_and_real_citations():
+    assert "对象、组件或触发条件连接两份资料" in SYSTEM
+    assert "同一条 evidence_ids 中引用各自的实际依据" in SYSTEM
+    assert "共同词汇，不足以证明关联、因果或攻击链" in SYSTEM
+    assert "条件性联系、案例对照或可能路径只能标 inference" in SYSTEM
+    assert "引用未覆盖连接两端的条目须剔除" in SYSTEM
+    assert "不虚构对象关系" in SYSTEM
+
+
+def test_ordinary_questions_combine_conditions_in_at_most_four_substantive_claims():
+    assert "concise 必须最多4条" in SYSTEM
+    assert "8条只是详细模式的 schema 上限" in SYSTEM
+    assert "必要条件合并进它限定的结论" in SYSTEM
+    assert "不单独拆成第5至8条" in SYSTEM
+    assert "合并不能删除关键条件" in SYSTEM
+    assert "claims 数量不超过 max_claims" in SYSTEM
+
+
+def test_pure_metadata_is_not_a_cited_inference_but_supported_conditions_remain():
+    assert "不得单独写成带引用的 fact/inference claim" in SYSTEM
+    assert "missing_fields、coverage 和 limitations 等结构元数据" in SYSTEM
+    assert "不另行生成缺口字段或标题" in SYSTEM
+    assert "不得把这类有效 inference 当作纯资料缺口删除" in SYSTEM
+    assert "真实适用条件和条件性关联不能因此被误删" in SYSTEM
+
+
+def test_briefness_does_not_weaken_factual_version_score_or_time_boundaries():
+    for boundary in [
+        "保留评分主体差异", "不同来源/不同CVSS版本分别保留",
+        "保留CPE条件未解析、版本范围未求值等限制",
+        "OSV ranges/events", "没有范围求值证据时",
+        "保留原 checked_at，不能声称刚刚重新查询",
+        "不能冒充来源发布时间、官方更新时间",
+        "一次 KEV 目录核查不能声称覆盖所有未知利用事件",
+        "不能证明未被利用", "只允许引用 payload.evidence 中的 evidence_id",
+        "不因追求简短批准省略关键条件",
+    ]:
+        assert boundary in SYSTEM
+    assert "根对象只允许 supported_claim_indexes 一个字段" in SYSTEM
+    assert "从0开始的纯 JSON 整数" in SYSTEM
