@@ -0,0 +1,53 @@
+import type { ChatMessage } from '../types/index'
+import { isUnverifiedMessage, showSecurityEvidence, warningCode, warningText } from './chatPresentation.ts'
+
+export const UNVERIFIED_NOTICE = '模型通用解释；未经过来源核验。'
+const unique = (values: string[]) => [...new Set(values.map(value => value.trim()).filter(Boolean))]
+const comparable = (value: string) => value.replace(/[\s，。；：,.!:;]+/g, '')
+
+/** Display-only cleanup. The response and stored history retain their original text. */
+export function displayedAnswer(message: ChatMessage): string {
+  if (!isUnverifiedMessage(message)) return message.content
+  return message.content.replaceAll(UNVERIFIED_NOTICE, '').trim()
+}
+
+export function answerLimitations(message: ChatMessage): string[] {
+  if (message.role !== 'assistant' || message.responseKind === 'conversation') return []
+  const notes = unique([
+    ...(message.workflow?.limitations || []),
+    ...(message.warnings || []).filter(note => !isUnverifiedMessage(message) || warningCode(note) !== 'llm_unverified').map(note => warningText([note])),
+  ])
+  const body = comparable(message.content)
+  return notes.filter(note => {
+    if (isUnverifiedMessage(message) && comparable(note) === comparable(UNVERIFIED_NOTICE)) return false
+    return !body.includes(comparable(note))
+  })
+}
+
+/** One compact summary; the returned details remain available below it. */
+export function answerGapSummary(message: ChatMessage): string {
+  if (message.role !== 'assistant' || message.id === 'welcome' || message.status === 'request_failed'
+    || !showSecurityEvidence(message)) return ''
+  const operationalWarnings = (message.warnings || []).filter(note => {
+    const code = warningCode(note)
+    return /^(?:search_|platform_model_|model_)/.test(code)
+      || ['local_retrieval_failed', 'retrieval_failed', 'relevance_check_failed', 'claim_support_check_failed'].includes(code)
+  })
+  if (operationalWarnings.length) {
+    const extra = operationalWarnings.length > 1 ? '；其他运行问题见下方详情' : ''
+    return `运行提示：${warningText([operationalWarnings[0]!])}${extra}。`
+  }
+  // The Agent already supplies a concise evidence boundary in these answers.
+  // Execution failures remain distinct and are surfaced above this check.
+  if (/【资料(?:边界|缺口)】/.test(message.content)) return ''
+  const unresolved = unique(message.workflow?.requirement_coverage
+    .filter(row => row.status !== 'supported').map(row => row.label) || [])
+  const missing = message.workflow?.requirement_coverage.length ? unresolved : unique(message.coverage?.missing_topics || [])
+  if (missing.length) {
+    const topics = missing.slice(0, 2).join('、')
+    return `待核实：${topics}${missing.length > 2 ? `等 ${missing.length} 项` : ''}。详见下方证据覆盖。`
+  }
+  if (message.status === 'partial') return '现有证据仅支持部分结论，详情可在下方核对。'
+  if (message.status === 'insufficient_evidence' && !message.evidence?.length) return '本次未取得可核验来源，详情可在下方查看。'
+  return answerLimitations(message).length ? '本次回答存在资料或运行限制，详情可在下方查看。' : ''
+}
