# Export variables in your shell; the package does not silently load .env files.
RAG_DB_PATH=data/ict.db
RAG_EMBEDDING_PROVIDER=e5
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_EMBEDDING_DEVICE=cpu
HF_HOME=.cache/huggingface
# extractive is the honest default without a model key; mock is only a test double.
RAG_LLM_MODE=extractive
RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-flash
RAG_LLM_KEY=
# Optional alternative: a local text file containing only the key.
# Do not set a nonempty RAG_LLM_KEY and RAG_LLM_KEY_FILE together.
RAG_LLM_KEY_FILE=
RAG_TIMEOUT=30
RAG_LLM_TIMEOUT=20

# Authenticated backend-facing adapter; independent from data/ict.db demo sources.
RAG_BACKEND_DB_PATH=data/backend-rag.db
# Set a shared private token; the V1 adapter rejects requests without configuration.
RAG_SERVICE_TOKEN=
# Worker reads backend tools with TOOL_TOKEN and claims/acks with WRITE_TOKEN.
# Both use the X-Agent-Token HTTP header, with different token values.
RAG_BACKEND_URL=http://127.0.0.1:8010
RAG_BACKEND_TOOL_TOKEN=
RAG_BACKEND_WRITE_TOKEN=
RAG_BACKEND_TIMEOUT=15
