# Export variables in your shell; the package does not silently load .env files.
RAG_DB_PATH=data/ict.db
RAG_EMBEDDING_PROVIDER=e5
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_EMBEDDING_DEVICE=cpu
HF_HOME=.cache/huggingface
# Standalone offline default. Fullstack launcher uses the platform model by
# default; select --extractive to run it without a remote model.
RAG_LLM_MODE=extractive
RAG_LLM_TRANSPORT=backend
RAG_LLM_GATEWAY_URL=http://127.0.0.1:8010
# Optional explicit token alias; defaults to RAG_BACKEND_TOOL_TOKEN below.
RAG_LLM_SERVICE_TOKEN=
RAG_LLM_BASE_URL=https://api.deepseek.com
RAG_LLM_MODEL=deepseek-flash
# These legacy settings are only accepted with RAG_LLM_TRANSPORT=direct.
# Never supply them to the Agent when using the platform backend transport.
RAG_LLM_KEY=
# Optional alternative: a local text file containing only the key.
# Do not set a nonempty RAG_LLM_KEY and RAG_LLM_KEY_FILE together.
RAG_LLM_KEY_FILE=
RAG_TIMEOUT=30
RAG_LLM_TIMEOUT=20
RAG_MAX_LLM_CALLS=6
RAG_MAX_TOOL_CALLS=10
RAG_MAX_RETRIEVAL_ROUNDS=3
# Stable concepts may fall back to a clearly labelled, uncited model explanation
# after unsuccessful retrieval. Specific vulnerability/version facts may not.
RAG_ALLOW_UNVERIFIED_CONCEPTS=true
# Standalone default. Fullstack launcher defaults to true only when this
# variable is absent; an explicitly exported false remains false.
# Extractive only disables model calls. Set false too for local-only queries.
RAG_EXTERNAL_TOOLS_ENABLED=false

# The following model settings belong to the FastAPI backend process only.
# Export one supplier secret or its private file path there, never in VITE_*.
# Do not bulk-export a populated backend key into a standalone Agent process.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_API_KEY_FILE=
# Generic web search credentials belong only to this backend as well.
# The fullstack launcher also recognises .secrets/tavily-api-key.
# Configure either the key or its private file, not both.
TAVILY_API_KEY=
TAVILY_API_KEY_FILE=

# Authenticated backend-facing adapter; independent from data/ict.db demo sources.
RAG_BACKEND_DB_PATH=data/backend-rag.db
# Set a shared private token; the V1 adapter rejects requests without configuration.
RAG_SERVICE_TOKEN=
# Worker reads backend tools with TOOL_TOKEN and claims/acks with WRITE_TOKEN.
# Both use the X-Agent-Token HTTP header, with different token values.
RAG_BACKEND_URL=http://127.0.0.1:8010
RAG_BACKEND_TOOL_TOKEN=
RAG_BACKEND_WRITE_TOKEN=
RAG_BACKEND_TIMEOUT=15
